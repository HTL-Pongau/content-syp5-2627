    {
      "id": "76dcf856-1be5-45af-8763-68a110a2f952",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Aus AUT1 (Teil 4) kennst du das Inventory ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "~/modules/hosts",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": ": Dort steht ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "ansible_become_pass=password",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": " im ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "Klartext",
          "styles": {
            "bold": true
          }
        },
        {
          "type": "text",
          "text": " (",
          "styles": {}
        },
        {
          "type": "text",
          "text": "[ubuntu:vars]",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": " und ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "[control:vars]",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": "). Im Lab ist das akzeptabel — in Produktion ein No-Go. Genau das ist Experte 4.3 bzw. Reflexionsfrage R4: ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "Wie löst man das „richtig\"?",
          "styles": {
            "italic": true
          }
        },
        {
          "type": "text",
          "text": " Antwort: ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "Ansible Vault",
          "styles": {
            "bold": true
          }
        },
        {
          "type": "text",
          "text": ".",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "31e4462f-1a37-469b-b82a-165429148810",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [],
      "children": []
    },
    {
      "id": "c56fce68-9ae1-4b30-b6dd-db70ae6701ae",
      "type": "heading",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left",
        "level": 2,
        "isToggleable": false
      },
      "content": [
        {
          "type": "text",
          "text": "Aufträge",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "72bf607f-80e7-4311-9c2f-9eaeb62b7f07",
      "type": "numberedListItem",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Vault-Datei anlegen:",
          "styles": {
            "bold": true
          }
        },
        {
          "type": "text",
          "text": " ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "cd ~/modules && mkdir -p group_vars/all && ansible-vault create group_vars/all/vault.yml",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": " — dort ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "become_pass: password",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": " eintragen (variabler Name z. B. ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "vault_become_pass",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": "). Die Klartext-Zeile ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "ansible_become_pass=…",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": " aus dem Inventory ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "entfernen",
          "styles": {
            "bold": true
          }
        },
        {
          "type": "text",
          "text": "; stattdessen in ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "group_vars/all/main.yml",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": ": ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "ansible_become_pass: \"{{ vault_become_pass }}\"",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": ".",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "f2ba6d07-f7b1-4367-be36-c2ee134a488b",
      "type": "numberedListItem",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Lauf testen:",
          "styles": {
            "bold": true
          }
        },
        {
          "type": "text",
          "text": " ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "ansible ubuntu -a \"whoami\" -o",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": " mit ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "--ask-vault-pass",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": " (Prompt) und danach mit ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "--vault-password-file ~/.vault_pass.txt",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": " (Datei vorher ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "chmod 600",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": "!). Ausgabe muss ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "root",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": " zeigen — vergleiche mit Teil 4.",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "1a8e0b62-864f-4f57-beaa-43de604e53b6",
      "type": "numberedListItem",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Bestehende Datei verschlüsseln:",
          "styles": {
            "bold": true
          }
        },
        {
          "type": "text",
          "text": " ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "ansible-vault encrypt secrets.yml",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": " — ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "head secrets.yml",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": " zeigt danach ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "$ANSIBLE_VAULT;1.1;AES256…",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": ". Teste auch ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "ansible-vault view",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": ", ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "edit",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": " und ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "rekey",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": " (neues Passwort setzen).",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "7e883f2e-59fe-47b2-9c4f-9fe8f0bdd257",
      "type": "numberedListItem",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Einzelwert inline verschlüsseln:",
          "styles": {
            "bold": true
          }
        },
        {
          "type": "text",
          "text": " ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "ansible-vault encrypt_string 'password' --name 'vault_become_pass'",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": " — den ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "!vault |",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": "-Block direkt in ein vars-File kopieren und testen.",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "897803eb-3243-4071-bdc1-3d4567b0ca7b",
      "type": "numberedListItem",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Control Node nicht vergessen:",
